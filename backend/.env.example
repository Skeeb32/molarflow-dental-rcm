# Local development defaults. Copy values into your shell before starting Django.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local development uses Django's console email backend by default.
# For email delivery, configure SMTP in the environment:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=MolarFlow <no-reply@example.com>

# Optional OAuth credentials. Provider buttons remain hidden until configured.
# Google OAuth redirect URI: http://localhost:5173/accounts/google/login/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft redirect URI: http://localhost:5173/accounts/microsoft/login/callback/
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# Apple redirect URI: http://localhost:5173/accounts/apple/login/callback/
# APPLE_SERVICE_ID=
# APPLE_KEY_ID=
# APPLE_TEAM_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Set these for a same-site HTTPS production deployment/reverse proxy.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=app.example.com
# FRONTEND_URL=https://app.example.com
# FRONTEND_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
